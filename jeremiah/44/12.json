    {
      "kind": "idiom",
      "subject": "שמו פניהם לבוא",
      "rationale": "Hibru 'ol dai putim pes bilong ol long go' i min 'ol i mekim wanpela tingting stret long go'; Tok Pisin i holdim piksa bilong pes."
    },
